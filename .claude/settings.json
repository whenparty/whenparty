{
  "extraKnownMarketplaces": {
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "modern-web-guidance@googlechrome": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpx modern-web-guidance@latest search *)",
      "Bash(pnpx modern-web-guidance@latest retrieve *)"
    ],
    "ask": [
      "Edit(**/package.json)",
      "Bash(pnpm add *)",
      "Bash(pnpm * add *)",
      "Bash(pnpm install *)",
      "Bash(pnpm * install *)",
      "Bash(pnpm i *)",
      "Bash(pnpm * i *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/doc-context.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_ENV_FILE\" ]; then echo 'export DISABLE_TELEMETRY=1' >> \"$CLAUDE_ENV_FILE\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/doc-context.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruleset-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/doc-context.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
