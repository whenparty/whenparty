{
  "permissions": {
    "ask": [
      "Edit(**/docs/specs/**)",
      "Edit(**/docs/PLANNED.md)",
      "Edit(**/package.json)",
      "Bash(pnpm add *)",
      "Bash(pnpm * add *)",
      "Bash(pnpm install *)",
      "Bash(pnpm * install *)",
      "Bash(pnpm i *)",
      "Bash(pnpm * i *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/doc-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/doc-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/doc-context.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/word-limit.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
