{
  "name": "games",
  "private": true,
  "description": "Peer-to-peer browser games on *.when.party and the platform they share",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"platform/*/src/**/*.{ts,mjs}\" \"titles/*/src/**/*.ts\"",
    "format:check": "prettier --check \"platform/*/src/**/*.{ts,mjs}\" \"titles/*/src/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
