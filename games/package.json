{
  "name": "games",
  "private": true,
  "description": "Peer-to-peer browser games on *.when.party and the platform they share",
  "type": "module",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "pnpm -r test",
    "test:browser": "sh tests/browser.sh",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"platform/*/src/**/*.{ts,mjs}\" \"titles/*/src/**/*.ts\" \"index/src/**/*.ts\" \"tests/*.mjs\" playwright.config.ts",
    "format:check": "prettier --check \"platform/*/src/**/*.{ts,mjs}\" \"titles/*/src/**/*.ts\" \"index/src/**/*.ts\" \"tests/*.mjs\" playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
